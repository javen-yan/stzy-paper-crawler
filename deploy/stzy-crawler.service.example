[Unit]
Description=STZY Paper Crawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stzy
Group=stzy
WorkingDirectory=/opt/stzy-crawler/app
EnvironmentFile=/opt/stzy-crawler/env
ExecStart=/opt/stzy-crawler/app/.venv/bin/python -m stzy_app.main --mode server --host ${STZY_HOST} --port ${STZY_PORT} --data-dir ${STZY_DATA_DIR}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
