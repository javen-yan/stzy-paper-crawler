STZY_DATA_DIR=/opt/stzy-crawler/data
STZY_HOST=0.0.0.0
STZY_PORT=8080
# Server 模式必须配置管理员密码。推荐使用哈希，避免明文密码出现在环境文件中。
STZY_ADMIN_PASSWORD_HASH=replace-with-output-of-hash-password
# 可选：也可以把密码放到仅 stzy 用户可读的文件中。若同时设置 HASH，优先使用 HASH。
# STZY_ADMIN_PASSWORD_FILE=/opt/stzy-crawler/secrets/admin-password
# 不推荐，但支持：STZY_ADMIN_PASSWORD=replace-with-strong-admin-password
STZY_MAX_ACTIVE_TASKS=2
STZY_MAX_DOWNLOAD_WORKERS=4
STZY_MAX_CONVERT_WORKERS=2
STZY_MAX_EXPORT_WORKERS=1
STZY_PREVIEW_MAX_PAGES=300
STZY_PREVIEW_TIMEOUT_SECONDS=45

# Word 字体。缺字体时先找本机原版，再下载开源同度量替代（Calibri→Carlito 等）。
# strict 表示只接受原版字体，不做替代。
STZY_WORD_FONT_POLICY=substitute
STZY_WORD_FONT_AUTO_INSTALL=1
# 有授权的原版字体目录（可选，转换进程通过独立 Fontconfig 加载，不改系统字体）。
# STZY_WORD_FONT_DIR=/opt/stzy-crawler/fonts-licensed
# 开源替代字体安装目录，默认 $STZY_DATA_DIR/fonts。
# STZY_FONT_INSTALL_DIR=/opt/stzy-crawler/data/fonts
