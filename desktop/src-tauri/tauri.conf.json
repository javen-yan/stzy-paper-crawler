{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STZY Paper Crawler",
  "version": "0.3.1",
  "identifier": "com.stzy.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/build_frontend.cjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "试卷下载器 · STZY Studio",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RjhFNUZGNTE3QkM2RTEKUldUaHhudFIvK1g0dDhNejQ0c2FDL1lpV0V5UVNmWXFqanhwcG5JOWR2UUllZmdpb25tbnh3RU8K",
      "endpoints": [
        "https://ghfast.top/https://github.com/javen-yan/stzy-paper-crawler/releases/latest/download/latest-mirror.json",
        "https://github.com/javen-yan/stzy-paper-crawler/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
