{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperDesk",
  "version": "0.3.8",
  "identifier": "com.stzy.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/build_frontend.cjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperDesk · 试卷下载器",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' stzyfile: http://stzyfile.localhost https://stzyfile.localhost; img-src 'self' stzyfile: http://stzyfile.localhost https://stzyfile.localhost data: blob:; media-src 'self' stzyfile: http://stzyfile.localhost https://stzyfile.localhost data: blob:; frame-src 'self' stzyfile: http://stzyfile.localhost https://stzyfile.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://ipc.localhost stzyfile: http://stzyfile.localhost https://stzyfile.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3RjhFNUZGNTE3QkM2RTEKUldUaHhudFIvK1g0dDhNejQ0c2FDL1lpV0V5UVNmWXFqanhwcG5JOWR2UUllZmdpb25tbnh3RU8K",
      "endpoints": [
        "https://ghfast.top/https://github.com/javen-yan/stzy-paper-crawler/releases/latest/download/latest-mirror.json",
        "https://github.com/javen-yan/stzy-paper-crawler/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
