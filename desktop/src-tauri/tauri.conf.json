{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STZY Paper Crawler",
  "version": "0.3.0",
  "identifier": "com.stzy.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/build_frontend.cjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "试卷下载器 · STZY Studio",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
